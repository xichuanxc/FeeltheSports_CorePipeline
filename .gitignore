# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.env

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/

# Data files (videos, analysis outputs).
# Exclude the contents rather than the directory itself, because git cannot
# re-include a file whose parent directory is excluded.
data/*
# ...but keep the annotation labels. These are hand-made, cost hours to
# produce and cannot be regenerated from the code, unlike everything else in
# here. The sidecar carries the rejections and hand-placed candidates, which
# are the same human decisions in a different form.
!data/*.csv
!data/*.annotator_state.json
# Player corrections are hand-made too: re-running analyzer.py restores the
# detected events but not the manual additions and removals layered on top.
!data/*.haptic.annotated.json

# Compiled training tensors — regenerable from the tracked CSVs by
# `python3 build_dataset.py`, so by the rule in docs/DATA_LAYOUT.md they stay
# out of git. 10 MB and rebuilt in about a minute.
dataset/

# Trained weights — rebuilt by train.py from the same CSVs, and retrained
# every time the dataset grows, so tracking them means binary churn for a
# derived artifact. Track one deliberately if a baseline needs pinning.
*.pth
*.onnx

# Old iterations — reference only, not part of active history
archive/

# Vision — exploratory YOLO research, large model files
vision/

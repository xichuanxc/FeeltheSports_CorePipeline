# macOS
.DS_Store

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.env

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/

# Data files (videos, analysis outputs).
# Exclude the contents rather than the directory itself, because git cannot
# re-include a file whose parent directory is excluded.
data/*
# ...but keep the annotation labels. These are hand-made, cost hours to
# produce and cannot be regenerated from the code, unlike everything else in
# here. The sidecar carries the rejections and hand-placed candidates, which
# are the same human decisions in a different form.
!data/*.csv
!data/*.annotator_state.json
# Player corrections are hand-made too: re-running analyzer.py restores the
# detected events but not the manual additions and removals layered on top.
!data/*.haptic.annotated.json
# The corpus inventory. Hand-written reference about what each video is for and
# how far it has been annotated; nothing in it can be regenerated from code.
!data/VIDEO_TABLE.md

# Compiled training tensors — regenerable from the tracked CSVs by
# `python3 build_dataset.py`, so by the rule in docs/DATA_LAYOUT.md they stay
# out of git. 10 MB and rebuilt in about a minute.
dataset/

# Trained weights — rebuilt by train.py from the same CSVs, and retrained
# every time the dataset grows, so tracking them means binary churn for a
# derived artifact. Track one deliberately if a baseline needs pinning.
*.pth
*.onnx
*.npz

# Scanned user-study questionnaires. These are participant records — the
# handwriting, and anything a participant wrote in a free-text box, are
# personal data, so they stay out of a repository that may be shared or made
# public. The derived, anonymised figures belong in docs/USER_STUDY.md instead.
docs/user_study_results/

# Cached Silero speech segments, keyed by video and threshold. Pure derived
# data — vad_impact.py recomputes any missing entry in a few seconds.
.vad_cache/

# The built deck. build_slides.py inlines docs/figures and docs/audio into
# docs/slides.src.html to produce it, and all three of those are tracked, so
# this is reproducible. Keeping it out avoids a 0.7 MB rewrite on every edit.
docs/slides.html

# Old iterations — reference only, not part of active history
archive/

# Vision — exploratory YOLO research, large model files
vision/

# Checksum of the last built deck, used by build_slides.py to notice a
# hand-edit of docs/slides.html before overwriting it.
docs/.slides.build.json

# Vision prototype: published pose weights and YOLO checkpoints, fetched
# by vision_prototype/fetch_models.sh rather than tracked.
vision_prototype/models/
vision_prototype/logs/
*.task
yolov8*.pt
